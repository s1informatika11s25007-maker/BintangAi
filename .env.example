# FRONTEND / VITE ENVIRONMENT VARIABLES
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_GROQ_TOKEN=your-groq-token
VITE_CUSTOM_AI_TUTOR_KEY=christian
VITE_APP_ENV=production

# SUPABASE EDGE FUNCTIONS & BACKEND RUNTIME
SUPABASE_PROJECT_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_DB_PASSWORD=your-db-password

# SUPABASE REAL DATABASE CONNECTION POOLER
SUPABASE_DB_POOLER_URL=postgres://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# AI MODEL PROVIDER & GITHUB INTEGRATIONS
Groq_Token=your-groq-token
MODEL_GATEWAY_BASE_URL=https://api.groq.com/openai/v1
GH_TOKEN=your-github-token
